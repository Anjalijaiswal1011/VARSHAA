# ==============================================================================
# RAIN-REPAIR X (VARSHAA) — Environment Configuration Template
# Copy this file to .env and configure local/server values
# NEVER commit the actual .env file to version control
# ==============================================================================

# Project & Runtime Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
PROJECT_NAME="RAIN-REPAIR X (VARSHAA)"
VERSION=1.0.0

# Base File Paths (relative to project root or absolute)
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed
DATA_EXTERNAL_DIR=data/external
MODELS_CHECKPOINT_DIR=models/checkpoints
LOGS_DIR=logs

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Data Domain Spatial Bounds (Indian Subcontinent Standard)
LAT_MIN=6.0
LAT_MAX=38.0
LON_MIN=68.0
LON_MAX=98.0
GRID_RESOLUTION_DEG=0.25

# ML Inference & Training Defaults
DEFAULT_RANDOM_SEED=42
QUANTILE_PREDICTIONS=[0.1, 0.5, 0.75, 0.9, 0.95]
HEAVY_RAIN_THRESHOLD_MM=64.5
VERY_HEAVY_RAIN_THRESHOLD_MM=115.6
EXTREME_RAIN_THRESHOLD_MM=204.5

# External Services / Optional API Keys (Leave blank if local)
IMD_API_KEY=""
ECMWF_API_KEY=""
